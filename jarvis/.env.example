# Optional: Nur als Fallback für den allerersten Start. Die eigentliche,
# änderbare Quelle für alle API-Keys ist der Connector-Store - siehe
# POST/PUT /connectors in server_api.py.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Verschlüsselt die im Connector-Store gespeicherten Secrets. Wird beim ersten
# Start automatisch generiert (data/master.key), falls nicht gesetzt - für
# Produktivbetrieb hier fest vorgeben (z. B. `python -c "from cryptography.fernet
# import Fernet; print(Fernet.generate_key().decode())"`).
JARVIS_MASTER_KEY=

API_AUTH_TOKEN=change-me

# Für das Vercel-Frontend: die Origin(s) deines Deployments eintragen,
# z. B. https://jarvis-frontend.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=*

CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-2.5-flash

SERVER_HOST=0.0.0.0
SERVER_PORT=8420
SERVER_BASE_URL=http://localhost:8420

ROUTING_MODE=heuristic
LOG_LEVEL=INFO

WEATHER_API_KEY=
