# Google Cloud APIs
GOOGLE_API_KEY=your-api-key
GOOGLE_AI_API_KEY=your-ai-api-key
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_CLOUD_BUCKET=your-bucket-name

# TikTok Integration (MCP)
TIKTOK_OAUTH_TOKEN=your-token
TIKTOK_CLIENT_ID=your-client-id
TIKTOK_CLIENT_SECRET=your-secret

# Instagram Integration (MCP)
INSTAGRAM_OAUTH_TOKEN=your-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-account-id

# Firebase
FIREBASE_API_KEY=your-api-key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-bucket

# Video Processing
MAX_VIDEO_SIZE_MB=500
SUPPORTED_FORMATS=mp4,mov,avi,webm
FFMPEG_PATH=/usr/bin/ffmpeg

# API Settings
API_TIMEOUT=300000
VIDEO_ANALYSIS_TIMEOUT=60000
BATCH_SIZE=5

# Application
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false
